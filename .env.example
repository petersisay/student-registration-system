# ==============================================================================
# Ethiopian Elementary School Management System - Environment Configuration
# Copy this file to .env and configure your local or production settings.
# IMPORTANT: NEVER commit the actual .env file or production secrets to Git/GitHub!
# ==============================================================================

# Server HTTP Port (default: 8080)
PORT=8080

# Environment Mode: development / test / production
APP_ENV=development

# Cloud / Remote MySQL Connection URI (e.g. Render, Railway, Fly.io, TiDB, Aiven)
# If set, DATABASE_URL overrides discrete DB_* variables below:
# DATABASE_URL=mysql://<user>:<password>@<host>:<port>/<dbname>

# Discrete MySQL Connection Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_db
DB_USER=root
DB_PASSWORD=

# Initial Administrator Credentials (provisioned safely on first migration)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123

# Toggle demonstration seed accounts for local development (set to false for clean production)
SEED_DEFAULT_ACCOUNTS=true

# External APIs & Webhooks (keep these in .env and never commit actual keys to source control)
# SMS_GATEWAY_API_KEY=
# CLOUD_STORAGE_SECRET=
